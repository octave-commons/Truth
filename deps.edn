{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        metosin/malli {:mvn/version "0.16.4"}
        org.lwjgl/lwjgl {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-glfw {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-opengl {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-stb {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl$natives-linux {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-glfw$natives-linux {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-opengl$natives-linux {:mvn/version "3.3.3"}
        org.lwjgl/lwjgl-stb$natives-linux {:mvn/version "3.3.3"}}
  :aliases
  {:bench {:extra-paths ["bench"]
          :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}
          :main-opts ["-m" "gates-of-truth.bench"]}
   :bench-coverage {:extra-paths ["bench"]
                    :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}
                    :main-opts ["-m" "gates-of-truth.bench.coverage"]}
   :test {:extra-paths ["test" "bench"]
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       criterium/criterium {:mvn/version "0.4.6"}}
          :main-opts ["-m" "cognitect.test-runner"]
          :exec-fn cognitect.test-runner.api/test}
   ;; --- Grouped test runners (load only selected namespaces) ----------------
   :test-runner {:main-opts ["-m" "test-runner"]
                 :extra-deps {}}
   :unit-test {:main-opts ["-m" "test-runner" "-g" "fast"]}
   :integration-test {:main-opts ["-m" "test-runner" "-g" "integration"]}
   :domain-test {:main-opts ["-m" "test-runner" "-g" "domain"]}
   :infra-test {:main-opts ["-m" "test-runner" "-g" "infra"]}
   :law-test {:main-opts ["-m" "test-runner" "-g" "law"]}
   :shape-test {:main-opts ["-m" "test-runner" "-g" "shape"]}
   :render-test {:main-opts ["-m" "test-runner" "-g" "render"]}
   :architecture-test {:main-opts ["-m" "test-runner" "-g" "architecture"]}
   :full-test {:main-opts ["-m" "test-runner" "-g" "all"]}
   :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}}
          :main-opts ["-m" "nrepl.cmdline"]}
    :dev  {:extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}}
           :main-opts ["-m" "infra.dev.server"]}
     :dashboard {:extra-deps {org.commonmark/commonmark {:mvn/version "0.21.0"}
                               org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.21.0"}}
                 :main-opts ["-m" "infra.dev.actor-dashboard"]}
    :run {:main-opts ["-m" "infra.main"]}
   ;; --- Static analysis (see bin/analyze + docs/STATIC-ANALYSIS.md) ---------
   ;; Splint: idiomatic-style / anti-pattern linter (maintained kibit successor).
   :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.24.0"}}
            :main-opts ["-m" "noahtheduke.splint" "src" "test"]}
   ;; --- Test coverage (cloverage; see bin/coverage + docs/TESTING.md) ---------
   ;; Instruments src, runs the test suite, reports line/form coverage. bin/coverage
   ;; supplies -p/-s/report flags. Whole tree is measured (all tests pass headless).
    :coverage {:extra-paths ["test" "bench"]
               :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                            nrepl/nrepl {:mvn/version "1.0.0"}
                            criterium/criterium {:mvn/version "0.4.6"}
                            org.commonmark/commonmark {:mvn/version "0.21.0"}
                            org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.21.0"}}
               :main-opts ["-m" "cloverage.coverage"]}
   ;; --- Mutation testing (Heretic; EXPERIMENTAL) -----------------------------
   ;; Heretic (github.com/parenstech/heretic) maps tests→code via ClojureStorm,
   ;; mutates source, and re-runs only the covering tests. ClojureStorm REPLACES
   ;; the Clojure compiler — isolated to THIS alias only; the normal build is
   ;; untouched. Config in heretic.edn; wrapper bin/mutate; docs/TESTING.md.
   ;; Pinned to main@45ed7c7 (no released tags exist; upstream is pre-1.0).
   ;; Only domain/law/shape are instrumented — mutating GL/infra is low-value.
   :heretic {:extra-paths ["test"]
             :classpath-overrides {org.clojure/clojure nil}
             :extra-deps {io.github.parenstech/heretic
                          {:git/sha "45ed7c7deffd5fee1b3050efa7396d0113b30a4f"}
                          com.github.flow-storm/clojure {:mvn/version "1.12.5"}}
             :jvm-opts ["-Dclojure.storm.instrumentEnable=true"
                        "-Dclojure.storm.instrumentAutoPrefixes=false"
                        "-Dclojure.storm.instrumentOnlyPrefixes=domain,law,shape"]}
   ;; cljfmt: formatting consistency. `check` reports; `fix` rewrites.
   :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.4"}}
            :main-opts ["-m" "cljfmt.main"]}
   ;; Launch Jupyter Lab with the clojupyter kernel.
   ;; Installs the kernel on first run: clojupyter.kernel/install
   ;; Connects to the running nREPL on port 7888 so notebooks share live
   ;; world-state with the simulation process.
   :notebook {:extra-deps {clojupyter/clojupyter {:mvn/version "0.4.332"}
                            nrepl/nrepl {:mvn/version "1.0.0"}}
              :main-opts ["-m" "clojupyter.cmdline" "install"]
              ;; After kernel is installed, start JupyterLab:
              ;; jupyter lab --port 8888 --no-browser
              ;; PM2 handles that via the ecosystem script above.
              }}}
