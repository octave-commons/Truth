[Unit]
Description=truth-research-biology deep research session (OpenCode)
After=network-online.target opencode-server.service
Requires=opencode-server.service

[Service]
WorkingDirectory=/home/err/spaces/Truth
KillMode=process
Type=oneshot
ExecStart=/home/err/.agents/skills/eta-mu-actor-agent/scripts/dispatch-actor.sh truth-research-biology "Start a deep research session. Pick the highest-priority topic from your goals, search arxiv, read papers, and produce a complete research notebook in your domain directory under docs/research/. Follow the deep-research skill format. Run for as long as needed."
Environment="HOME=%h"
Environment="USER=%u"
Environment="PATH=%h/.local/share/pnpm:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=default.target
