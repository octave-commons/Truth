[Unit]
Description=Skill spore review actor for Gates of Truth
After=network-online.target opencode-server.service

[Service]
Type=oneshot
ExecStart=%h/spaces/Truth/.eta-mu/actors/spore-reviewer/runtime/systemd-runner.sh
Environment="HOME=%h"
Environment="USER=%u"
Environment="PATH=%h/.opencode/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=default.target
