  "command": {
    "invocation": "python3 - <<'PY' (standard-library Fraction arithmetic and audit; exact arithmetic body below)",
    "python": "3.12.3 (main, Aug 31 2026, 10:18:26) [GCC 13.3.0]",
    "arithmetic_source": "from fractions import Fraction as F\nE = (\"H\",\"He\",\"D\",\"He3\",\"Li7\",\"C\",\"N\",\"O\",\"Ne\",\"Na\",\"Mg\",\"Al\",\"Si\",\"S\",\"Ca\",\"Fe\",\"Ni\")\ndef amounts(**xs):\n    return {e:F(xs.get(e,0)) for e in E}\ndef total(x):\n    return sum(x.values(),F(0))\ndef add(*xs):\n    return {e:sum((x[e] for x in xs),F(0)) for e in E}\ndef scale(x,k):\n    return {e:v*k for e,v in x.items()}\ndef subtract(x,y):\n    return {e:x[e]-y[e] for e in E}\ndef allocate(b,rs,rg,eta,f):\n    a=subtract(subtract(b,rs),rg)\n    assert min(a.values())>=0 and 0<=eta<=1 and 0<=f<=1\n    q=eta*min(a[\"H\"]/(2*F(\"1.008\")),a[\"O\"]/F(\"15.999\"))\n    water=amounts(H=2*F(\"1.008\")*q,O=F(\"15.999\")*q)\n    wi,wv=scale(water,f),scale(water,1-f)\n    u=subtract(a,water)\n    p={\"other-solid\":rs,\"other-gas\":rg,\"water-ice\":wi,\"water-vapor\":wv,\"unassigned\":u}\n    assert add(*p.values())==b\n    return q,p\ndef draw(p,mc,mg):\n    s=add(p[\"other-solid\"],p[\"water-ice\"])\n    g=add(p[\"other-gas\"],p[\"water-vapor\"])\n    S,G=total(s),total(g)\n    if not (0<=mc<=S and 0<=mg<=G):\n        return {\"outcome\":\"phase-overdraw\",\"input\":p,\"unchanged\":p}\n    a=mc/S if S else F(0)\n    b=mg/G if G else F(0)\n    child={}\n    remaining={}\n    for k,v in p.items():\n        fraction=a if k in (\"other-solid\",\"water-ice\") else b if k in (\"other-gas\",\"water-vapor\") else F(0)\n        child[k]=scale(v,fraction)\n        remaining[k]=scale(v,1-fraction)\n    assert add(*p.values())==add(*remaining.values(),*child.values())\n    assert total(add(*child.values()))==mc+mg\n    assert all(x>=0 for comp in remaining.values() for x in comp.values())\n    return {\"outcome\":\"planned\",\"child\":child,\"remaining\":remaining}\nzero=amounts()\nstockA=amounts(H=\"2.016\",O=\"23.9985\",C=\"12.011\")\ngasA=amounts(O=\"15.999\",C=\"12.011\")\nqA,pA=allocate(stockA,zero,gasA,F(1),F(1))\ndrawA=draw(pA,F(\"4.50375\"),F(\"14.005\"))\nassert qA==F(1,2)\nassert add(*drawA[\"child\"].values())==amounts(H=\".504\",O=\"11.99925\",C=\"6.0055\")\nassert add(*drawA[\"remaining\"].values())==amounts(H=\"1.512\",O=\"11.99925\",C=\"6.0055\")\nstockB=amounts(O=\"23.9985\",C=\"12.011\")\nqB,pB=allocate(stockB,zero,gasA,F(1),F(1))\ndrawB=draw(pB,F(0),F(0))\nrejectB=draw(pB,F(\"0.001\"),F(0))\nassert qB==0 and drawB[\"remaining\"]==pB and rejectB[\"outcome\"]==\"phase-overdraw\"\nstockC=amounts(H=\"2.016\",O=\"15.999\")\nqC,pC=allocate(stockC,zero,zero,F(1),F(1,10))\nS=total(add(pC[\"other-solid\"],pC[\"water-ice\"]))\nG=total(add(pC[\"other-gas\"],pC[\"water-vapor\"]))\nhypothetical=scale(stockC,F(1,5))\nassert S==F(\"1.8015\") and G==F(\"16.2135\")\nassert hypothetical==amounts(H=\".4032\",O=\"3.1998\")\nassert all(hypothetical[e]<=stockC[e] for e in E)\nrejectC=draw(pC,F(\"3.603\"),F(0))\nassert rejectC[\"outcome\"]==\"phase-overdraw\" and rejectC[\"unchanged\"]==pC\nqD,pD=allocate(stockC,zero,zero,F(1),F(1))\ndrawD1=draw(pD,F(\"6.005\"),F(0))\ndrawD2=draw(drawD1[\"remaining\"],F(\"12.01\"),F(0))\nrejectD3=draw(drawD2[\"remaining\"],F(\".001\"),F(0))\nassert add(*drawD1[\"child\"].values())==amounts(H=\".672\",O=\"5.333\")\nassert add(*drawD1[\"remaining\"].values())==amounts(H=\"1.344\",O=\"10.666\")\nassert add(*drawD2[\"remaining\"].values())==zero\nassert rejectD3[\"outcome\"]==\"phase-overdraw\"\nassert add(*drawD1[\"child\"].values(),*drawD2[\"child\"].values())==stockC\nraw={\n \"A\":{\"stock\":stockA,\"other-solid\":zero,\"other-gas\":gasA,\"eta\":F(1),\"f\":F(1),\"water-kmol\":qA,\"allocation\":pA,\"request\":{\"core\":F(\"4.50375\"),\"gas\":F(\"14.005\")},\"draw\":drawA},\n \"B\":{\"stock\":stockB,\"other-solid\":zero,\"other-gas\":gasA,\"eta\":F(1),\"f\":F(1),\"water-kmol\":qB,\"allocation\":pB,\"zero-draw\":drawB,\"positive-solid-reject\":rejectB},\n \"C\":{\"stock\":stockC,\"other-solid\":zero,\"other-gas\":zero,\"eta\":F(1),\"f\":F(1,10),\"water-kmol\":qC,\"allocation\":pC,\"solid-mass\":S,\"gas-mass\":G,\"request\":{\"core\":F(\"3.603\"),\"gas\":F(0)},\"hypothetical-total-element-draw\":hypothetical,\"result\":rejectC},\n \"D\":{\"stock\":stockC,\"other-solid\":zero,\"other-gas\":zero,\"eta\":F(1),\"f\":F(1),\"allocation\":pD,\"requests\":[F(\"6.005\"),F(\"12.01\"),F(\".001\")],\"first\":drawD1,\"second\":drawD2,\"third\":rejectD3}}\ndef encode(x):\n    if isinstance(x,F): return [x.numerator,x.denominator]\n    if isinstance(x,dict): return {k:encode(v) for k,v in x.items()}\n    if isinstance(x,list): return [encode(v) for v in x]\n    return x\nraw=encode(raw)\n",
    "exit_condition": "All assertions pass before design-audit.json is written"
  },
