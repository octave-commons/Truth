  "substantive_assessment": [
    {
      "subject": "Limited validation and opaque legacy extras",
      "verdict": "PASS",
      "rationale": "The outer plan is closed but the legacy stellar spec remains open. Map-shaped extras overlay the seed map before final known-field checks; unknown key/value payloads remain exact and explicitly unvalidated. Non-map extra containers and the reserved life-book key are named new rejections, not silently claimed compatible behavior. Optional known extras are checked when present, including nil. Composition checks elemental key membership and each fraction without inventing H/He positivity or sum-to-one certification. An angular-momentum override does not recompute the already-derived spin.",
      "plan_evidence": [
        "docs/notes/2026-10-07-first-represented-life-boundary.md:546",
        "kanban/tasks/validated-fresh-entity-construction.md:39"
      ],
      "source_evidence": [
