        "test/domain/disk_evolution_test.clj:248",
        "docs/designs/multi-timescale-integration.md:192"
      ]
    },
    {
      "subject": "Closed empty-book capability and singleton checks",
      "verdict": "PASS",
      "rationale": "The empty-book constructor accepts only the exact v1 map with integer cursor0 and empty maps, producing only component/life-book. Both current component-column and archetype occurrences, malformed/orphaned occurrences and a second book plan are rejected. Stellar extras cannot bypass this constructor via the reserved key, even with nil. The check is conditional on an explicit book request and does not claim universal world validity, history repair, cross-branch deduplication, automatic first-event allocation or a live biological producer.",
      "plan_evidence": [
        "docs/notes/2026-10-07-first-represented-life-boundary.md:608",
        "docs/notes/2026-10-07-first-represented-life-boundary.md:629",
        "kanban/tasks/validated-fresh-entity-construction.md:50"
      ],
      "source_evidence": [
        "src/domain/ecs/core.clj:1",
        "src/domain/ecs/core.clj:24",
        "src/domain/ecs/core.clj:52"
      ]
    },
    {
      "subject": "Fresh IDs and pure-result atomicity",
      "verdict": "PASS",
      "rationale": "The plan disallows target IDs on creation plans, checks the actual next ID against alive, archetypes and every component column, and repeats freshness checks against running results before calling existing spawn/put-components. These checks address the current allocator's unchecked assoc/conj behavior. It promises no accepted partial result after any later failure, including no consumed request or advanced allocator; callers retain their original immutable world. It does not introduce a transaction service or claim persistence atomicity.",
      "plan_evidence": [
        "docs/notes/2026-10-07-first-represented-life-boundary.md:547",
        "docs/notes/2026-10-07-first-represented-life-boundary.md:645",
        "kanban/tasks/validated-fresh-entity-construction.md:107"
      ],
      "source_evidence": [
        "src/domain/ecs/core.clj:24",
        "src/domain/ecs/core.clj:52",
        "src/domain/ecs/core.clj:167",
        "src/domain/genesis/bootstrap.clj:310"
      ]
    },
    {
      "subject": "Initialization, request consumption, reaping and ongoing ownership",
      "verdict": "PASS",
      "rationale": "One descriptor is added to the existing registry with narrow initializes/consumes/reaps authorities. Known initialization and the separately named exact per-plan opaque-extra key rule are fresh-ID-only; request removal is restricted to seven processed request families and reaping to six existing marker families. Ordinary writes remain empty for this descriptor and all-stage conflicts remain checked, so future ongoing book/cohort ownership cannot hide behind the new stage. The plan correctly identifies that fan-out-systems currently filters only barrier and that runtime dispatch is a separate explicit system list; both routes must exclude construction and have regression controls.",
      "plan_evidence": [
        "docs/notes/2026-10-07-first-represented-life-boundary.md:666",
        "kanban/tasks/validated-fresh-entity-construction.md:112"
      ],
      "source_evidence": [
